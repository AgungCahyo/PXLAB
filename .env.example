NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Not used by the Next.js app. Only the delete-account Edge Function needs it:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
#   supabase functions deploy delete-account
SUPABASE_SERVICE_ROLE_KEY=
# Local: http://localhost:3000 — Production canonical: https://pxlb.fun
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Required in production: signs recovery links and encrypts one-time reset tickets.
# Generate with: openssl rand -base64 32
AUTH_RECOVERY_SECRET=
# Login/reset/register/account limits are in-process (1h windows; 20/IP + 10/email for login).
# Pair them with host/proxy rate limits — counters reset on each deploy.
# SEC-01..05: enable Supabase "Secure email change" and reauthentication emails for
# OAuth accounts; the pinned auth-js has no listSessions(), so session management
# offers "other devices" and "every device" revocation instead of per-session rows.
# Supabase Auth → URL Configuration must allow (query strings included):
#   {NEXT_PUBLIC_SITE_URL}/auth/callback?**   (confirmation/magic link/OAuth, ?next=)
#   {NEXT_PUBLIC_SITE_URL}/auth/recovery?**   (query carries state + token_hash)
# IMPORTANT: assign supabase/templates/reset-password.html in Auth → Email Templates →
# Reset Password. It links to /auth/recovery?state=...&token_hash=...&type=recovery,
# which works from any browser/app. The default {{ .ConfirmationURL }} uses PKCE and
# fails when the email is opened somewhere other than the requesting browser.
# Keep "Confirm email" enabled for password signups; Google OAuth email is already verified.
# For Google: Authentication → Providers → Google enabled + Client ID/Secret.
# Also add the same callback URL in Google Cloud OAuth client authorized redirects:
#   https://<project-ref>.supabase.co/auth/v1/callback
# Retired for /space after B5. Playground owns PixelBoard. Safe to leave unset.
NEXT_PUBLIC_PIXEL_CANVAS_PROTOTYPE=
